{
  "image": "suricata-hardened",
  "version": {
    "key": "suricata"
  },
  "revision": [
    "suricata",
    "Dockerfile",
    "init.go",
    "go.mod",
    "oisf.gpg.asc",
    "scripts/",
    "versions.json"
  ],
  "platforms": [
    "linux/amd64"
  ],
  "compose_service": "suricata",
  "probes": [
    {
      "label": "Suricata",
      "want": "version",
      "cmd": "docker exec suricata-hardened suricata -V",
      "regex": "Suricata version \\K[0-9][0-9.]*"
    }
  ],
  "smoke": "./scripts/test-alerts.sh suricata-hardened"
}
